<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fav_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6121218"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/fav_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Favorieten"
        android:textColor="#E8E0FF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/fav_slot_0"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:textSize="11sp" />

        <Button
            android:id="@+id/fav_slot_1"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textSize="11sp" />

        <Button
            android:id="@+id/fav_slot_2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textSize="11sp" />

        <Button
            android:id="@+id/fav_slot_3"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
