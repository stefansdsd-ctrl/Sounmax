<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6121218"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sounmax"
            android:textColor="#E8E0FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BT --%"
            android:textColor="#86EFAC"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_dsp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="DSP aan"
        android:textColor="#B8B0C8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_scene"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Scene"
        android:textColor="#C4B5FD"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_sleep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Timer uit"
        android:textColor="#93C5FD"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_dsp_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="DSP"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_prev_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="0.7"
            android:text="◀"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_scene_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Scene"
            android:textSize="11sp" />

        <Button
            android:id="@+id/widget_sleep_btn"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Timer"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
